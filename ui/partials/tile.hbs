<div class="cta__wrapper">
    <div>
        <div class="cta-content__wrapper">
            <div class="cta__icon">
                <svg viewBox="0 0 512 512" width="28" height="28" aria-hidden="true" focusable="false">
                    <path fill="currentColor"
                        d="M176 56l0 40 160 0 0-40c0-4.4-3.6-8-8-8L184 48c-4.4 0-8 3.6-8 8zM128 96l0-40c0-30.9 25.1-56 56-56L328 0c30.9 0 56 25.1 56 56l0 40 0 32 0 352-256 0 0-352 0-32zM64 96l32 0 0 384-32 0c-35.3 0-64-28.7-64-64L0 160c0-35.3 28.7-64 64-64zM448 480l-32 0 0-384 32 0c35.3 0 64 28.7 64 64l0 256c0 35.3-28.7 64-64 64z" />
                </svg>
            </div>
            <div>
                <h3 class="text-h__body">
                    {{language.cta.heading}}
                </h2>
                <p class="text-p__body">
                    {{language.cta.text}}
                </p>
            </div>
        </div>
    </div>
    <div class="action__wrapper">
        <button class="normal__button">
            {{language.cta.button.text}}
        </button>
        <div>
            <a href="{{language.cta.link.url}}" class="list-body__link">{{language.cta.link.text}} <span
                    aria-hidden="true">&rarr;</span></a>
        </div>
    </div>
</div>