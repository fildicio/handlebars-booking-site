{{#each language.mainHeading.tiles}}
<div class="tile__wrapper">
    <img src="{{src}}" alt="" class="image__body">
    <div class="tile__content">
        <h2 class="text-h__body">{{heading}}</h2>
        <p class="text-p__body">{{text}}</p>
        {{#each links}}
        <div>
            <a href="{{url}}" class="list-body__link">{{text}} <span aria-hidden="true">&rarr;</span></a>
        </div>
        {{/each}}
    </div>
</div>
{{/each}}
