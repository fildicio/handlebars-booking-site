{{> header}}

<div role="main" id="srNavMain">
    {{#if hideHero}}
        <div>
            <div>
                {{#if title}}<h1>{{title}}</h1>{{/if}}
            </div>
        </div>
    {{else}}
        {{> page-hero}}
    {{/if}}

    <div>
        {{#if subtitle}}<h2>{{{subtitle}}}</h2>{{/if}}
        <div class="{{#if mainContentClass}}{{mainContentClass}}{{/if}}">
            {{> body}}
        </div>
    </div>
</div>

{{> footer}}
